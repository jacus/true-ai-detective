# Copy to `.env` and fill in what you have: `cp .env.example .env`. `.env` is git-ignored; never commit it.
#
# How it is used: `just` loads `.env` into the environment of every recipe (`set dotenv-load` in the
# justfile), so the app and its libraries (OpenAI SDK, LangChain, LangSmith, boto3) read the same real
# environment variables locally as they do on Railway. The app itself never reads this file.
# On Railway these are service variables instead: secrets are `preserve()` in .railway/railway.ts and set
# with `railway variable set NAME --stdin --service api`, so their values never touch the repo.
#
# Tests (`just test`) need none of this: they talk to fake OpenAI/LangSmith servers, replay recorded HTTP
# for the web, and drop every LANGSMITH_* variable, so they never make a paid call or send a trace.

# --- Models: needed to run the api locally (`just dev`) ---------------------------------------------------

# OpenAI: chat, vision and embeddings (gpt-5.4-nano, text-embedding-3-small). Required: the api creates its
# model clients at startup. Cheap by design: a chat turn costs a fraction of a cent. https://platform.openai.com
OPENAI_API_KEY=

# Vercel AI Gateway: the detective's next-step decisions (the JEV decision model, OpenAI Decisions API).
# Without it the api starts, but every chat turn fails at its first decision.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional overrides of the defaults in src/detective/settings.py (`provider:model` for LangChain).
# Changing the embedding model needs a migration (case_memory vectors are 1536-d) and `just reindex`.
# CHAT_MODEL=openai:gpt-5.4-nano
# EMBEDDING_MODEL=openai:text-embedding-3-small
# DECISION_MODEL=typesafe-ai/jev

# --- Observability (optional) -----------------------------------------------------------------------------

# LangSmith tracing, in the SDK's own variable names: LangChain and LangGraph trace every run by themselves.
# Leave LANGSMITH_TRACING unset to trace nothing. `just smoke` reads the deployed run's trace back with the key.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_PROJECT=true-ai-detective

# --- Your deployment (optional: `just smoke`, `just invite-prod`) ----------------------------------------

# The public addresses Railway gave your api and web services (Settings → Networking).
# DEPLOYED_API_URL=https://<your-api>.up.railway.app
# DEPLOYED_WEB_URL=https://<your-web>.up.railway.app

# A client account on your deployment (create it with `just invite-prod`); the smoke test resets its case.
# SMOKE_EMAIL=
# SMOKE_PASSWORD=

# --- Local infrastructure ---------------------------------------------------------------------------------
# Nothing to set: the defaults match compose.yaml (Postgres, RustFS as S3, SearXNG on :8888) and the justfile
# (local-only DB role password and S3 keys). Override DATABASE_URL, AWS_*, SEARX_URL… only to point elsewhere.
