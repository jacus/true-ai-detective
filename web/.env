# Committed, non-secret defaults for the web app (Next.js loads this in dev and `next start`).
# Real environment variables (Railway, tests) take precedence. Secrets go in web/.env.local (ignored).

# Privacy: never send CopilotKit telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# Where the Python detective agent (AG-UI endpoint) lives. Local default: `just dev`.
DETECTIVE_AGENT_URL=http://127.0.0.1:8000/agent
